{
  "version": 2,
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/zohoverify/(.*)", "dest": "/zohoverify/$1" },
    { "src": "/about/?", "dest": "/about.html" },
    { "src": "/partner/?", "dest": "/partner.html" },
    { "src": "/privacy/?", "dest": "/privacy.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ]
}
